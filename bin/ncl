#!/usr/bin/env bash
#
# ncl — NanoClaw CLI launcher.
#
# Resolves the project root from this script's location, cd's there so the
# host-resolved DATA_DIR matches the running host, and execs the TS entry
# via tsx. Symlink this file into a directory on your PATH (or alias `ncl`
# to its full path) to invoke from anywhere:
#
#   ln -s "$(pwd)/bin/ncl" /usr/local/bin/ncl
#   # or
#   alias ncl="$(pwd)/bin/ncl"

set -euo pipefail

SCRIPT="${BASH_SOURCE[0]}"
# Resolve symlinks so PROJECT_ROOT points at the real checkout.
while [ -h "$SCRIPT" ]; do
  DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [[ "$SCRIPT" != /* ]] && SCRIPT="$DIR/$SCRIPT"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT"

# Resolve a tsx runner. Prefer the checkout's OWN binary: a host can have deps
# installed but no pnpm on PATH (the deployed ss-smith-vm case — node_modules
# present, pnpm absent), and `pnpm exec` there fails with "exec: pnpm: not found",
# taking the whole CLI down with it. Falling back to pnpm keeps behaviour identical
# on dev boxes that have it but haven't installed into node_modules.
if [ -x "$PROJECT_ROOT/node_modules/.bin/tsx" ]; then
  exec "$PROJECT_ROOT/node_modules/.bin/tsx" src/cli/client.ts "$@"
elif command -v pnpm >/dev/null 2>&1; then
  exec pnpm exec tsx src/cli/client.ts "$@"
fi

# Deliberately no npx fallback: npx would silently download tsx from the network on
# a box that has neither, which is a surprising side effect for a CLI launcher.
# Fail loudly with the fix instead.
echo "ncl: no tsx runner found in $PROJECT_ROOT" >&2
echo "ncl: install dependencies (pnpm install) so node_modules/.bin/tsx exists, or put pnpm on PATH." >&2
exit 1
